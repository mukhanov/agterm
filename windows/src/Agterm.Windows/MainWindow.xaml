<Window
    x:Class="Agterm.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="agterm">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="6,10,6,6">
        <Button x:Name="NewSessionButton" Content="session+" Click="OnNewSession" Padding="6,3" />
        <Button x:Name="NewWorkspaceButton" Content="ws+" Click="OnNewWorkspace" Padding="6,3" />
        <Button x:Name="SplitButton" Content="⬓" Click="OnSplit" Padding="6,3" />
        <Button x:Name="DashboardButton" Content="▦" Click="OnDashboard" Padding="6,3" />
      </StackPanel>
      <ScrollViewer Grid.Row="1" Padding="4,0,4,8">
        <StackPanel x:Name="SidebarList" Spacing="1" />
      </ScrollViewer>
    </Grid>
    <Border Grid.Column="1" x:Name="DeckHost" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
  </Grid>
</Window>

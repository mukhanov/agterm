# downloaded prebuilt libghostty (never committed — see scripts/setup.sh)
# no trailing slash so the symlink form (worktree setup) is ignored too, not just the dir
GhosttyKit.xcframework
agterm/Resources/ghostty
agterm/Resources/terminfo
.ghostty-build-stamp
agterm/Resources/zmx
.zmx-build-stamp
*.tar.gz

# build artifacts
build/
.build/
agterm.xcodeproj/
.swiftpm/

.DS_Store

# app state / runtime files (only appear if AGTERM_STATE_DIR is pointed at the repo)
settings.json
windows.json
workspaces.json
*.sock

# windows/ holds the Windows port source (windows-port branch); stray per-window state dirs that a
# pointed-at-the-repo run drops next to windows.json land at the repo root and stay ignored by the
# *.json / *.sock rules above
!windows/
windows/**/bin/
windows/**/obj/
windows/tools/golden/.build/

# python tooling leftovers from the cookbook recipes: bytecode cache and the ruff lint cache
__pycache__/
.ruff_cache/

# revmux review scaffolding: caller-written task context plus its run archive, local to a review.
# profile.md is the exception — it calibrates every review of this repo, so it is tracked. Excluding
# the directory itself would make that re-include unreachable, hence the glob.
.revmux/*
!.revmux/profile.md

# track the path-scoped Claude rules (the global ~/.gitignore_global ignores .claude/)
!.claude/
.claude/*
!.claude/rules/

# windows publish artifacts
windows/dist/
agterm-windows-*.zip

# ad-hoc capture logs
windows/src/Agterm.Windows/err*.txt
